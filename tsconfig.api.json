{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,

    /* Node ESM, as Vercel runs the functions: relative imports need .js */
    "module": "nodenext",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "api/**/*.ts",
    "src/server/**/*.ts",
    "src/domain/breakdowns.ts",
    "src/data/machines.ts",
    "src/types/breakdown.ts"
  ]
}
