# Shared storage (US-05): Upstash Redis from the Vercel Marketplace.
# On Vercel these are added automatically when you connect the database to the project
# (Storage -> Upstash for Redis). Without them the app stores data in each browser.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=your-token
# The Upstash names also work:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
